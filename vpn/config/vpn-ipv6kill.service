[Unit]
Description=Block new IPv6 egress (the VPN is IPv4-only, so no client traffic leaks over IPv6)
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/ip6tables -I OUTPUT 1 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
ExecStart=/sbin/ip6tables -I OUTPUT 2 -o lo -j ACCEPT
ExecStart=/sbin/ip6tables -A OUTPUT -j REJECT
[Install]
WantedBy=multi-user.target
