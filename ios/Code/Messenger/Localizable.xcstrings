    },
    "Speech recognition is not available for this language": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание речи на устройстве недоступно для этого языка"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
