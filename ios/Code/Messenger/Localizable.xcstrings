    "A post rides the pipe of each person, so only the people you write with are listed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пост идёт по каналу каждого человека, поэтому в списке только те, с кем вы переписываетесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帖子经由每个人各自的通道传送，因此这里只列出与你有通信的人。"
          }
        }
      }
    },
