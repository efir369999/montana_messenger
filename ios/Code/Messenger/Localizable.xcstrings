    "The other side closed this conversation: these messages can be read, not answered. To write again, open a new contact.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собеседник закрыл эту беседу: сообщения можно читать, но ответить на них нельзя. Чтобы писать снова, откройте новый контакт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方已关闭此对话：这些消息可以阅读，无法回复。要再次写信，请建立新的联系。"
          }
        }
      }
    },
