    "Your phone reads the page of a link you send, so that site sees this phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone reads the page of a link you send, so that site sees this phone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой телефон читает страницу ссылки, которую ты отправляешь, — сайт видит этот телефон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你发送链接时，本机会读取该网页，因此该网站会看到这台手机。"
          }
        }
      }
    },
    "Your tools": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши инструменты"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的工具"
          }
        }
      }
    },
    "Your video is not sent. Allow the camera in Settings › Montana › Camera — iOS restarts Montana when the switch changes. Come back within a minute, and the call goes on.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your video is not sent. Allow the camera in Settings › Montana › Camera — iOS restarts Montana when the switch changes. Come back within a minute, and the call goes on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше видео не отправляется. Разрешите камеру в Настройки › Montana › Камера — iOS перезапускает Montana при смене переключателя. Вернитесь в течение минуты — и звонок продолжится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的视频未发送。请在“设置 › Montana › 相机”中允许相机——切换开关时 iOS 会重启 Montana。请在一分钟内返回，通话将继续。"
          }
        }
      }
    },
    "Your video is not sent. Allow the camera in Settings › Montana › Camera, then call again — iOS restarts Montana when the switch changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your video is not sent. Allow the camera in Settings › Montana › Camera, then call again — iOS restarts Montana when the switch changes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше видео не отправляется. Разрешите камеру в Настройки › Montana › Камера и позвоните снова — iOS перезапускает Montana при смене переключателя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的视频未发送。请在“设置 › Montana › 相机”中允许相机，然后重新拨打——切换开关时 iOS 会重启 Montana。"
          }
        }
      }
    },
