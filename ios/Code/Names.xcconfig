// THE PRODUCTS' NAMES -- ONE OWNER EACH (constitution article 15, the author's word 04.11.2026 11:02 UTC, link 16053: «a name has
// one source of truth, it is an invariant ... do not allow several owners anywhere»). Every name a person reads as an app's own --
// under the icon, on the share sheet, in the «Open in» choice between the two apps (the author's word 16049) -- is this file's line;
// the project, both Info.plists and the code only read it. The project's base configuration (Debug and Release) is this file;
// tools/mt-names-check.py keeps every other place a reader.
// THE BUILD'S NUMBER AND VERSION have their own owner beside the names (constitution article 15, the author's word 19159):
#include "../Version.xcconfig"

MT_NAME_PROTOCOL = MT Protocol
// The Mac product is MT Protocol too (decision 829 = a, 11.11.2026: the site and the releases mac-v1.0-N name it so); its
// bundle, volume, files and release read this line through tools/mt_names.py.
MT_NAME_PROTOCOL_MAC = MT Protocol
MT_NAME_MESSENGER = Montana
// THE APPS' NAMES IN THE STORE (the author's decision 642 and word 16777, 04.11.2026 23:14 UTC): Apple refuses «Montana» as a
// store's name -- 409 DUPLICATE.DIFFERENT_ACCOUNT, held by another account; each page is named by its line here alone
// (tools/mt-appstore.py), and the names under the icons stay the lines above.
MT_NAME_PROTOCOL_STORE = Montana Protocol
MT_NAME_MESSENGER_STORE = Montana Messenger
// THE DEVELOPER, AS APP STORE CONNECT NAMES THE ACCOUNT (the author's decision 716, link 17592, 06.11.2026 17:32 UTC: «Artur
// Karajan»): the App Store shows it under both apps' names; the sites' «Provider» reads this line (store.py names_line).
MT_DEVELOPER = Artur Karajan

// THE APPS' LINK SCHEMES -- ONE OWNER EACH (the author's word 16667, 05.11.2026: «montana:// for the Messenger and mt-protocol://»):
// each app registers its own, both Info.plists name both to ask whether the other stands, and the «Open in» choice reads them
// from Info.plist (MTSiblingApps). montana:// is also the letters' own link form (montana://r/, coin, wall): every app reads it
// in its text views by the one entrance (MontanaMeeting.handleLink), never by the system's round.
MT_SCHEME_PROTOCOL = mt-protocol
MT_SCHEME_MESSENGER = montana
