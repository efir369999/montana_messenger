<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>$(MONTANA_APP_NAME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>montana</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>MontanaPhoneAppDoor</key>
	<string>tg</string>
	<key>MontanaPhoneService</key>
	<string>id.montana.quest</string>
	<key>NSCameraUsageDescription</key>
	<string>Montana uses the camera for photos and videos in your chats, video messages and video calls, and to scan a person's QR code.</string>
	<key>NSContactsUsageDescription</key>
	<string>Montana uses your contacts so you can share one in a chat, and saves the people you add in Montana to your contacts by their @name. Turn this off in Settings, Privacy, Sync contacts.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Montana uses Face ID to show your 24-word recovery phrase.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Montana uses your location so you can send it in a chat.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Montana uses the microphone to record voice messages, videos and calls.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Montana saves photos from your chats to your library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Montana shows your recent photos and videos so you can send one quickly.</string>
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.quest.montana.app</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<false/>
			<key>NSUbiquitousContainerName</key>
			<string>Montana</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
		<key>iCloud.quest.montana.Montana</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<false/>
			<key>NSUbiquitousContainerName</key>
			<string>Montana</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
		<string>INStartCallIntent</string>
		<string>INStartAudioCallIntent</string>
		<string>INStartVideoCallIntent</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(MONTANA_APP_ID).wake</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>voip</string>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
