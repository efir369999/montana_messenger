        }
      }
    },
    "Your name @%@ has lapsed. Take it again, or another.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок имени @%@ истёк. Займите его снова или другое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的名字 @%@ 已过期。重新取得它，或另选一个。"
          }
        }
      }
    },
    "Your name is no longer yours: the node that keeps names holds another key under it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя больше не ваше: узел, который хранит имена, держит под ним другой ключ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的名字已不再属于你：保存名字的节点在它下面保存着另一个密钥。"
          }
        }
      }
    },
    "Your name says who you are; the code opens the conversation.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя говорит, кто вы; код открывает переписку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字说明您是谁；二维码开启对话。"
          }
        }
      }
    },
    "Your name: @%@, held until %@. Taking another releases it for good.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше имя: @%@, закреплено до %@. Взяв другое, вы навсегда освободите это."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的名字：@%@，持有至 %@。选用另一个名字会永久释放它。"
          }
        }
      }
    },
    "Your name: @%@. Taking another releases it for good.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше имя: @%@. Взяв другое, вы навсегда освободите это."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的名字：@%@。选用另一个名字会永久释放它。"
          }
        }
      }
    },
    "Your node": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш узел"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的节点"
          }
        }
      }
    },
    "Your node (optional)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш узел (необязательно)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的节点（可选）"
          }
        }
      }
    },
    "Your node did not answer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш узел не ответил"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的节点没有回应"
          }
        }
      }
    },
    "Your node did not take the copy: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш узел не принял копию: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的节点未接收副本：%@"
          }
        }
      }
    },
    "Your node holds no copy": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашем узле копии нет"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的节点没有副本"
          }
        }
      }
    },
    "Your node holds no copy yet.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашем узле пока нет копии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的节点还没有副本。"
          }
        }
      }
    },
    "Your node is a machine you own: your backup, your space. Once a day over Wi-Fi, while Montana is open, a copy of the whole app goes there, sealed with the key your 24 words open; the words are not in it. On a new phone, enter the address and the words, and the copy comes back.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш узел — машина, которой владеете вы: ваша копия, ваше пространство. Раз в день по Wi-Fi, пока Montana открыта, туда уходит копия всего приложения, запечатанная ключом, который открывают ваши 24 слова; самих слов в ней нет. На новом телефоне введите адрес и слова — и копия вернётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的节点是您自己拥有的机器：您的备份，您的空间。当 Montana 打开时，每天通过 Wi-Fi 将整个应用的副本发送到那里，并用您的 24 个词打开的密钥封存；副本中不含这些词。在新手机上输入地址和这些词，副本就会回来。"
          }
        }
      }
    },
    "Your node is set up: its door stands at %@ and its certificate is pinned.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш узел настроен: дверь стоит на %@, сертификат закреплён."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的节点已设置：门位于 %@，证书已固定。"
          }
        }
      }
    },
    "A node is reached over the internet: give the address it has there, not one of your local network.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До узла доходят через интернет: укажите его интернет-адрес, а не адрес из вашей локальной сети."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节点通过互联网访问：请填写它在互联网上的地址，而不是你本地网络中的地址。"
          }
        }
      }
    },
    "Your node refused": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш узел отказал"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的节点拒绝了"
          }
        }
      }
    },
    "Your phone reads the page of a link you send, so that site sees this phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone reads the page of a link you send, so that site sees this phone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой телефон читает страницу ссылки, которую ты отправляешь, — сайт видит этот телефон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你发送链接时，本机会读取该网页，因此该网站会看到这台手机。"
          }
        }
      }
    },
    "Your pieces": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши фигуры"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的棋子"
          }
        }
      }
    },
    "Your tools": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши инструменты"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的工具"
          }
        }
      }
    },
    "Your video is not sent. Allow the camera in Settings › Montana › Camera — iOS restarts Montana when the switch changes. Come back within a minute, and the call goes on.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your video is not sent. Allow the camera in Settings › Montana › Camera — iOS restarts Montana when the switch changes. Come back within a minute, and the call goes on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше видео не отправляется. Разрешите камеру в Настройки › Montana › Камера — iOS перезапускает Montana при смене переключателя. Вернитесь в течение минуты — и звонок продолжится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的视频未发送。请在“设置 › Montana › 相机”中允许相机——切换开关时 iOS 会重启 Montana。请在一分钟内返回，通话将继续。"
          }
        }
      }
    },
    "Your video is not sent. Allow the camera in Settings › Montana › Camera, then call again — iOS restarts Montana when the switch changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your video is not sent. Allow the camera in Settings › Montana › Camera, then call again — iOS restarts Montana when the switch changes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше видео не отправляется. Разрешите камеру в Настройки › Montana › Камера и позвоните снова — iOS перезапускает Montana при смене переключателя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的视频未发送。请在“设置 › Montana › 相机”中允许相机，然后重新拨打——切换开关时 iOS 会重启 Montana。"
          }
        }
      }
    },
