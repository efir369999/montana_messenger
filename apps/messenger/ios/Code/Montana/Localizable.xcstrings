            "state": "translated",
            "value": "测量"
          }
        }
      }
    },
    "The name could not be checked right now. Try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удалось проверить имя. Попробуйте ещё раз."
