    "The node is busy. Try again in a minute.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узел занят. Попробуйте через минуту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节点繁忙，请一分钟后重试。"
          }
        }
      }
    },
    "The node is starting. An invitation appears as soon as it is up.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узел поднимается. Приглашение появится, как только он будет готов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节点正在启动。就绪后即可生成邀请。"
          }
        }
      }
    },
    "The node that keeps names cannot be reached. Try again.": {
      "localizations": {
