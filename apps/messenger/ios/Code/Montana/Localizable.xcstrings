    "iCloud Drive is not available here. Sign in to iCloud, turn iCloud Drive on, and try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive здесь недоступен. Войдите в iCloud, включите iCloud Drive и повторите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处无法使用 iCloud Drive。请在系统设置中启用 iCloud 与 iCloud Drive 后重试。"
          }
        }
      }
    },
    "iCloud Drive is off on this device, or no Apple Account is signed in. The identity is open; a copy can be taken later in Settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive на этом устройстве выключен, или не выполнен вход в учётную запись Apple. Личность открыта; копию можно забрать позже в Настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的 iCloud Drive 已关闭，或未登录 Apple 账户。身份已打开；稍后可在设置中取回副本。"
          }
        }
      }
    },
    "iCloud Drive is off on this device.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве выключен iCloud Drive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的 iCloud Drive 已关闭。"
          }
        }
      }
    },
    "iCloud Drive is off on this device: Settings, your name, iCloud, iCloud Drive (%@).": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве выключен iCloud Drive: Настройки → ваше имя → iCloud → iCloud Drive (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备已关闭 iCloud 云盘：设置 → 你的姓名 → iCloud → iCloud 云盘（%@）。"
          }
        }
      }
    },
    "iCloud asks you to sign in to your Apple Account again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud просит снова войти в Apple Account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 要求您重新登录 Apple 账户。"
          }
        }
      }
    },
    "iCloud asks you to sign in to your Apple Account again: Settings, your name (%@).": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud просит снова войти в Apple Account: Настройки → ваше имя (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 要求你重新登录 Apple 账户：设置 → 你的姓名（%@）。"
          }
        }
      }
    },
    "iCloud could not reach its servers (%@). It continues on its own once connected; on mobile data it may wait for Wi-Fi.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud не смог связаться со своими серверами (%@). Выгрузка продолжится сама, когда появится связь; по мобильной сети iCloud может ждать Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 无法连接其服务器（%@）。连接恢复后会自动继续；使用蜂窝网络时，iCloud 可能会等待 Wi-Fi。"
          }
        }
      }
    },
    "iCloud could not reach its servers; the track is still in iCloud. Try again on Wi-Fi.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud не смог связаться со своими серверами; трек остаётся в iCloud. Попробуйте ещё раз по Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 无法连接到其服务器；曲目仍在 iCloud 中。请在 Wi-Fi 下重试。"
          }
        }
      }
    },
    "iCloud did not take the copy: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud не принял копию: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 未接收备份：%@"
          }
        }
      }
    },
    "iCloud has no room for the new copy (%@) next to the one it holds.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В iCloud нет места для новой копии (%@) рядом с прежней."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 没有空间在保留上一份副本的同时存放新副本（%@）。"
          }
        }
      }
    },
    "iCloud holds no copy of this identity yet.": {
      "localizations": {
