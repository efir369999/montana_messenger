    "You will not receive messages, calls, typing or presence from this person. They will see neither your photo nor when you were last seen.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не будете получать сообщения, звонки, набор и присутствие от этого человека. Он не увидит ни вашего фото, ни когда вы были в сети."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您将不会收到此人的消息、通话、输入状态或在线状态。对方将看不到您的头像，也看不到您的最后在线时间。"
          }
        }
      }
    },
