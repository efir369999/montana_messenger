{
  "sourceLanguage": "en",
  "strings": {
    "Available": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用"
          }
        }
      }
    },
    "Accept the game": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принять"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受对局"
          }
        }
      }
    },
    "Decline the game": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отклонить"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝对局"
          }
        }
      }
    },
    "Country": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страна"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "国家或地区"
          }
        }
      }
    },
    "Next": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Далее"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一步"
          }
        }
      }
    },
    "Tap the button to confirm your number in our bot, then come back here.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку, подтвердите номер в нашем боте и вернитесь сюда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按按钮，在我们的机器人中确认号码，然后返回这里。"
          }
        }
      }
    },
    "Verify Number": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Верификация номера"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证号码"
          }
        }
      }
    },
    "Waiting for the confirmation…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждём подтверждения…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待确认…"
          }
        }
      }
    },
    "How would you like to get the code?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как вы хотите получить код?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您希望如何接收验证码？"
          }
        }
      }
    },
    "Phone number confirmation is unavailable right now": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone number confirmation is unavailable right now"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждение номера сейчас недоступно"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机号码验证暂时不可用"
          }
        }
      }
    },
    "Continue without a number": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue without a number"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить без номера"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不使用号码继续"
          }
        }
      }
    },
    "Search for a country or region": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск страны или региона"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索国家或地区"
          }
        }
      }
    },
    "Choose your country or region": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите страну или регион"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择国家或地区"
          }
        }
      }
    },
    "The confirmation service did not answer. Try again in a minute.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба подтверждения не ответила. Попробуйте через минуту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认服务没有响应。请一分钟后重试。"
          }
        }
      }
    },
    "The confirmation took too long. Start again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждение заняло слишком много времени. Начните заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认耗时过长。请重新开始。"
          }
        }
      }
    },
    "The confirmation does not match this number.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждение не совпадает с этим номером."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认与此号码不符。"
          }
        }
      }
    },
    "The sign-in did not come back. Start again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход не вернулся в приложение. Начните заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录没有返回应用。请重新开始。"
          }
        }
      }
    },
    "This account has no verified number.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого аккаунта нет подтверждённого номера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账号没有已验证的号码。"
          }
        }
      }
    },
    "Continue with phone number": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with phone number"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По номеру телефона"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用手机号码继续"
          }
        }
      }
    },
    "Join us via phone number": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход по номеру телефона"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过手机号码加入"
          }
        }
      }
    },
    "A messaging bot confirms your number; no text message is sent": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер подтверждает бот в мессенджере, СМС не отправляется"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由消息机器人确认你的号码，不发送短信"
          }
        }
      }
    },
    "What is a channel?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что такое канал?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么是频道？"
          }
        }
      }
    },
    "A channel sends your posts to the people you choose.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Канал рассылает ваши посты людям, которых вы выбрали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道会把你的帖子发送给你选择的人。"
          }
        }
      }
    },
    "Only you post; subscribers read.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пишете только вы, подписчики читают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你能发布，订阅者阅读。"
          }
        }
      }
    },
    "Every post goes phone to phone, over the pipe you hold with each subscriber.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый пост идёт с телефона на телефон — по каналу каждого подписчика."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每条帖子都从手机直达手机，经由你与每位订阅者各自的通道。"
          }
        }
      }
    },
    "Channel name": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название канала"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道名称"
          }
        }
      }
    },
    "You can add a description to your channel.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно добавить описание канала."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以为频道添加描述。"
          }
        }
      }
    },
    "Add subscribers": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить подписчиков"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加订阅者"
          }
        }
      }
    },
    "A post rides the pipe of each person, so only the people you write with are listed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пост идёт по каналу каждого человека, поэтому в списке только те, с кем вы переписываетесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帖子经由每个人各自的通道传送，因此这里只列出与你有通信的人。"
          }
        }
      }
    },
    "No name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No name"
          }
        },
        "ru": {
          "stringUnit": {
