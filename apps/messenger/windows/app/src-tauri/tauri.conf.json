{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Montana",
  "version": "0.1.0",
  "identifier": "quest.montana.desktop.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Montana",
        "width": 1100,
        "height": 720,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: http://mtfile.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "Montana",
    "copyright": "Porting and adaptation from Montana iOS to Windows: DinetPDA — Linkora.",
    "shortDescription": "Montana — private messenger",
    "resources": {
      "../../target/release/mt_bindings.dll": "mt_bindings.dll",
      "../../target/release/montana_core.dll": "montana_core.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
