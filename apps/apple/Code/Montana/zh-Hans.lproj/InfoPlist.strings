/* The sentence a person reads when the system asks for a permission. The system localises
   its own half — the title and the buttons — and shows THIS half exactly as written, so a
   phrase without a translation reaches every language unchanged. The source is English
   (Info.plist); this file is one language of it. No sentence names the app:
   the system's title above it already does, by the name under the icon (Code/Names.xcconfig). */

"NSBluetoothAlwaysUsageDescription" = "蓝牙让手机直接互联，在附近交换消息。";
"NSCameraUsageDescription" = "相机用于在聊天中拍摄照片和视频、录制视频消息、进行视频通话，以及扫描他人的二维码。";
"NSFaceIDUsageDescription" = "面容 ID 用于打开你保存的密码，并显示你的 24 个恢复词。";
"NSLocalNetworkUsageDescription" = "你的设备与对方的设备通过 Wi-Fi 直接连接。该权限仅用于让手机在同一网络中找到彼此。";
"NSLocationWhenInUseUsageDescription" = "你的位置仅用于让你在聊天中发送它。";
"NSMicrophoneUsageDescription" = "麦克风用于录制语音消息、视频和通话。";
"NSSpeechRecognitionUsageDescription" = "语音识别在你的设备上进行，在你点按时将语音消息显示为文字。声音不会离开你的设备。";
