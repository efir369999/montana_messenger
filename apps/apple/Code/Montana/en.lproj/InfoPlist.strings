/* The sentence a person reads when the system asks for a permission. The system localises
   its own half — the title and the buttons — and shows THIS half exactly as written, so a
   phrase without a translation reaches every language unchanged. The source is English
   (Info.plist); this file is one language of it. No sentence names the app:
   the system's title above it already does, by the name under the icon (Code/Names.xcconfig). */

"NSBluetoothAlwaysUsageDescription" = "Bluetooth forms a direct device-to-device mesh, so your phones can exchange messages nearby.";
"NSCameraUsageDescription" = "The camera takes photos and videos for your chats, video messages and video calls, and scans a person's QR code.";
"NSFaceIDUsageDescription" = "Face ID opens your saved passwords and shows your 24-word recovery phrase.";
"NSLocalNetworkUsageDescription" = "Your device and your correspondent's connect directly over Wi-Fi. The permission is needed only so the phones can find each other on the same network.";
"NSLocationWhenInUseUsageDescription" = "Your location is used only so you can send it in a chat.";
"NSMicrophoneUsageDescription" = "The microphone records voice messages, videos and calls.";
"NSSpeechRecognitionUsageDescription" = "Speech is recognised on your device to show a voice message as text when you ask. The audio never leaves your device.";
"NSPhotoLibraryAddUsageDescription" = "Photos from your chats are saved to your library.";
"NSPhotoLibraryUsageDescription" = "Your recent photos and videos are shown so you can send one quickly.";

/* The name iCloud gives this app's storage (NSUbiquitousContainers in Info.plist). The iCloud
   daemon keeps that name per language and takes each language's name from THIS file only (read
   in its own code, 23.09): without this line the container carried a name in no language at all,
   while Apple's storage page called it "app", the tail of the container's identifier. The
   name is the product's own, Code/Names.xcconfig MT_NAME_PROTOCOL, in every language: tools/mt-names-check.py holds this
   line equal to it (rule 8). */
"NSUbiquitousContainerName" = "MT Protocol";
