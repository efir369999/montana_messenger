    },
    "Everyone except": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone except"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все, кроме"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除以下人外所有人"
          }
        }
      }
    },
    "Everyone means every person you have a conversation with. A wall reaches a person's page the moment they open it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone means every person you have a conversation with. A wall reaches a person's page the moment they open it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Все» — это каждый, с кем у вас есть переписка. Стена приходит на страницу человека в тот момент, когда он её открывает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“所有人”指与你有对话的每一个人。留言墙会在对方打开你的页面时立即到达。"
          }
        }
      }
    },
    "Everyone on the mesh, phone to phone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone on the mesh, phone to phone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все в мэше, от телефона к телефону"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网状网络中的所有人，手机对手机"
          }
        }
      }
    },
    "Everyone will see it at the top of the chat.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все увидят его вверху чата."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有人都会在聊天顶部看到它。"
          }
        }
      }
    },
    "Everything here stays on your device. Nothing is published: your correspondent sees only what you choose to show. Leave the name empty and your call sign is used.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что здесь, остаётся на устройстве. Ничего не публикуется: собеседник видит только то, что вы решили показать. Оставите имя пустым — вас будут звать позывным."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处的一切都留在您的设备上。不会公开任何内容：对方只能看到您选择展示的内容。名称留空则使用您的呼号。"
          }
        }
      }
    },
    "Everything is erased: messages and files on this device, the identity itself, the profile and the username, which becomes free for anyone. This cannot be undone — the seed phrase will not bring it back, because there will be nothing left to restore.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стирается всё: переписка и файлы на этом устройстве, сама личность, профиль и имя пользователя, которое станет свободным для любого. Отменить это нельзя — сид-фраза не вернёт ничего, потому что восстанавливать будет нечего."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都将被抹除：本机的消息与文件、身份本身、个人资料以及用户名（将对任何人开放）。此操作无法撤销——助记词也无法找回，因为已无可恢复之物。"
          }
        }
      }
    },
    "Exactly 24 words required (entered \\(words.count))": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
