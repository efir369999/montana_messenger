          }
        }
      }
    },
    "The “About” section is visible to everyone.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раздел «О себе» виден всем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「关于我」部分对所有人可见。"
          }
        }
      }
    },
    "Their bubble": {
      "localizations": {
