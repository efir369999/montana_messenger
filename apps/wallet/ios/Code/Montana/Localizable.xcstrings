    "Not delivered, coins returned": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не доставлено, монеты возвращены"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未送达，硬币已退回"
          }
        }
      }
    },
    "Coins from an earlier version": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Монеты прежней версии"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "早期版本的硬币"
          }
        }
      }
