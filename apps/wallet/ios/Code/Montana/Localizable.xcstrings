    "You will not receive messages, calls, typing or presence from this person. They will see neither your photo nor when you were last seen.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не будете получать сообщения, звонки, набор и присутствие от этого человека. Он не увидит ни вашего фото, ни когда вы были в сети."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您将不会收到此人的消息、通话、输入状态或在线状态。对方将看不到您的头像，也看不到您的最后在线时间。"
          }
        }
      }
    },
    "You won": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы выиграли"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你赢了"
          }
        }
      }
    },
    "Your 24-word seed phrase": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша сид-фраза из 24 слов"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 24 个单词助记词"
          }
        }
      }
    },
    "Your Apple Account carries more than one identity of Montana. Choose the one to open on this phone.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В вашей учётной записи Apple хранится несколько личностей Montana. Выберите ту, которую открыть на этом телефоне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Apple 账户中保存了多个 Montana 身份。请选择要在此手机上打开的身份。"
          }
