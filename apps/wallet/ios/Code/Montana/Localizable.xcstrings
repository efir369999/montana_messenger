    "iOS restarts Montana when an access is changed in Settings, and the call ends.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS restarts Montana when an access is changed in Settings, and the call ends."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда в Настройках меняют доступ, iOS перезапускает Montana, и звонок завершается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中更改访问权限时，iOS 会重新启动 Montana，通话将会结束。"
          }
        }
      }
    },
    "iOS restarts Montana when an access is changed in Settings. Come back to Montana within a minute, and the call goes on.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS restarts Montana when an access is changed in Settings. Come back to Montana within a minute, and the call goes on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда в Настройках меняют доступ, iOS перезапускает Montana. Вернитесь в Montana в течение минуты — и звонок продолжится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中更改访问权限时，iOS 会重新启动 Montana。请在一分钟内回到 Montana，通话将继续。"
          }
        }
      }
    },
    "iOS will ask permission to find devices on the local network — only so the phones can see each other.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS запросит разрешение находить устройства в локальной сети — только чтобы телефоны видели друг друга."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会请求在本地网络中查找设备的权限——仅用于让手机彼此可见。"
          }
        }
      }
    },
    "iOS will ask permission to show notifications. The text is decrypted on this device — nothing readable leaves it.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS спросит разрешение показывать уведомления. Текст расшифровывается на этом устройстве — наружу не уходит ничего читаемого."
          }
        },
        "zh-Hans": {
