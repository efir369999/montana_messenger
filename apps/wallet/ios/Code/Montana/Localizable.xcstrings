          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом телефоне одна личность Montana. Другая заменит её и её чаты на этом телефоне; её сид-фраза и сделанные копии останутся там, где они есть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
