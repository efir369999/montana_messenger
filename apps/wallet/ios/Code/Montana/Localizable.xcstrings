        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Написать"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发消息"
          }
        }
      }
    },
    "Write a comment": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a comment"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Написать комментарий"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写评论"
          }
        }
      }
    },
    "Write down these 24 words in order and keep them offline. They restore your history if you lose all your devices. Don't show them to anyone.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите эти 24 слова по порядку и храните офлайн. По ним восстанавливается история, если вы потеряете все устройства. Никому не показывайте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按顺序写下这 24 个单词并离线保存。如果您丢失所有设备，可用它们恢复聊天记录。请勿向任何人展示。"
          }
        }
      }
    },
    "Write on the wall": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write on the wall"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Написать на стене"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在留言墙上发帖"
          }
        }
      }
    },
    "Write something": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write something"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишите что-нибудь"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写点什么"
          }
        }
      }
    },
    "Write the first one — it will wait for them on a node": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write the first one — it will wait for them on a node"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишите первое — оно дождётся на узле"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写下第一条 — 它会在节点上等待对方"
          }
        }
      }
    },
    "Write to me on Montana: %@": {
      "localizations": {
