    "Your video is not sent. Allow the camera in Settings › Montana › Camera — iOS restarts Montana when the switch changes. Come back within a minute, and the call goes on.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your video is not sent. Allow the camera in Settings › Montana › Camera — iOS restarts Montana when the switch changes. Come back within a minute, and the call goes on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше видео не отправляется. Разрешите камеру в Настройки › Montana › Камера — iOS перезапускает Montana при смене переключателя. Вернитесь в течение минуты — и звонок продолжится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的视频未发送。请在“设置 › Montana › 相机”中允许相机——切换开关时 iOS 会重启 Montana。请在一分钟内返回，通话将继续。"
          }
        }
      }
