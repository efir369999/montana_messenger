            "state": "translated",
            "value": "此设备上的 iCloud Drive 已关闭。"
          }
        }
      }
    },
    "iCloud Drive is off on this device: Settings, your name, iCloud, iCloud Drive (%@).": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве выключен iCloud Drive: Настройки → ваше имя → iCloud → iCloud Drive (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
