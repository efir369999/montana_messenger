        }
      }
    },
    "Enter the reference the person gave you. You can only write to someone who has an identity.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите ссылку, которую дал человек. Писать можно только тому, у кого есть личность."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入对方给您的引用。您只能写信给拥有身份的人。"
          }
        }
      }
    },
    "Every attachment the letters name is on this device.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все вложения, на которые ссылаются письма, есть на этом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息中提到的所有附件都在本设备上。"
          }
        }
      }
    },
    "Everyone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone"
          }
        },
        "ru": {
          "stringUnit": {
