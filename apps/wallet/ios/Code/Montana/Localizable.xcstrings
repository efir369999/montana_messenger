        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 名成员"
                }
              }
            }
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld из %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld"
          }
        }
      }
    },
    "%lld · %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld · %@"
          }
        }
      }
    },
    "%lld%% · %@ of %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%% · %@ из %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%% · %@ / %@"
          }
        }
      }
    },
    "24 hours. To keep it forever, open it and tap “Pin to Page”.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "24 часа. Если хотите оставить навсегда — откройте её и нажмите «Закрепить на странице»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "24 小时。若想永久保留，打开后点击“置顶到页面”。"
          }
        }
      }
    },
    "24 words are the only key to your identity and chats. They're revealed only after confirmation with your device passcode or biometrics.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "24 слова — единственный ключ к личности и переписке. Открываются только после подтверждения кодом или биометрией устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这 24 个单词是您身份和聊天的唯一密钥。只有在通过设备密码或生物识别确认后才会显示。"
          }
        }
      }
    },
    "75-move rule": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "75-move rule"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило 75 ходов"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "75回合规则"
          }
        }
      }
    },
    "< 1 minute": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "< 1 минуты"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "< 1 分钟"
          }
        }
      }
    },
    "@name": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "@имя"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "@名字"
          }
        }
      }
    },
    "@username": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "@ник"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "@用户名"
          }
        }
      }
    },
    "A backup holds every conversation and attachment this device keeps, sealed with the key your 24 words open. Keep the words: without them nobody can read it, and neither can you.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия содержит все беседы и вложения этого устройства и запечатана ключом, который открывают ваши 24 слова. Берегите слова: без них копию не прочтёт никто — и вы тоже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份包含本设备保存的全部对话与附件，并由您的 24 个助记词所对应的密钥封存。请妥善保管助记词：没有它们，任何人都无法读取备份，您自己也不能。"
          }
        }
      }
    },
    "A contact is added by name: the network resolves it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакт добавляется по имени: сеть находит его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过名字添加联系人：由网络解析。"
          }
        }
      }
    },
    "A contact is added by username: the address is resolved by the network.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакт добавляется по имени пользователя: адрес находит сеть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过用户名添加联系人：地址由网络解析。"
          }
        }
      }
    },
    "A conversation left out is not read at all: none of its letters, names, faces or attachments go into the copy.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Беседа, оставленная вне копии, не читается вовсе: ни её письма, ни имена, ни лица, ни вложения в копию не попадают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选中的对话完全不会被读取：其消息、名称、头像和附件均不会进入备份。"
          }
        }
      }
    },
    "A letter arrives at your phone even when Montana is closed. A notification is how the phone tells you about it.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Письмо приходит на телефон и тогда, когда Montana закрыта. Уведомление — то, как телефон вам об этом говорит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使 Montana 已关闭，信件也会送到您的手机。通知就是手机告知您的方式。"
          }
        }
      }
    },
    "A name is held by renewing its record, not by the life of a person: miss the renewal and the cell is free for whoever takes it next, the previous owner keeping no advantage. A name is not transferable — an operation of transfer does not exist. There is no arbitration: no trademarks, no complaints, no exceptions. Only your own addresses stand behind a name; a foreign address cannot be listed under it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя держится продлением записи, а не жизнью человека: пропустили продление — ячейка свободна, её берёт следующий, и преимущества у прежнего владельца нет. Имя не передаётся — операции передачи не существует. Арбитража нет: ни товарных знаков, ни жалоб, ни исключений. За именем стоят только собственные адреса владельца; чужой адрес указать нельзя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称靠续期记录维持，而非靠人的生命：错过续期，位置即空出，由下一个人取得，原持有者不享优先。名称不可转让——不存在转让操作。没有仲裁：没有商标、没有申诉、没有例外。名称背后只能是本人的地址；不能登记他人的地址。"
          }
        }
      }
    },
    "A name is public: anyone who knows it can write to you first, and your link pzr.me/ with the name opens a chat with you. It stays yours while the app renews it — open Montana at least once every six weeks.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя публично: любой, кто его знает, может написать вам первым, а ваша ссылка pzr.me/ с именем открывает чат с вами. Имя остаётся вашим, пока приложение его продлевает, — открывайте Montana хотя бы раз в шесть недель."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字是公开的：任何知道它的人都可以先给你写信，而带有名字的 pzr.me/ 链接会打开与你的聊天。只要应用为它续期，名字就一直属于你——每六周至少打开一次 Montana。"
          }
        }
      }
    },
    "A name works for someone you have already met. To meet somebody new, scan their code.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя работает для того, с кем вы уже знакомы. Чтобы познакомиться с новым человеком, отсканируйте его код."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字适用于您已认识的人。要结识新的人，请扫描其二维码。"
          }
        }
      }
    },
    "A person sends you coins in your chat": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Человек присылает вам монеты в вашем чате"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人在你们的聊天中给你发送硬币"
          }
        }
      }
    },
    "A person who sends such content or abuses others is barred from Montana's relays and doors.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тот, кто рассылает такое содержимое или злоупотребляет в отношении других, лишается доступа к узлам и дверям Montana."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送此类内容或滥用他人者将被禁止使用 Montana 的中继与入口。"
          }
        }
      }
    },
    "A phone that passes a message on sees only ciphertext": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон, который передаёт сообщение дальше, видит только шифртекст"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转发消息的手机只看得到密文"
          }
        }
      }
    },
    "A post takes up to %lld files": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В запись входит не больше %lld файлов"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一条帖子最多包含 %lld 个文件"
          }
        }
      }
    },
    "A private account has no code and no link. Hand out a one-time card to be reached.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У приватного аккаунта нет ни кода, ни ссылки. Чтобы вас нашли, выдайте разовую карточку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私密账户没有二维码也没有链接。若要让人找到您，请发放一次性名片。"
          }
        }
      }
    },
    "A private account has no link and no code — it has no identifier at all. Hand out a one-time card to be reached.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У приватного аккаунта нет ни ссылки, ни кода — у него вообще нет идентификатора. Чтобы вас нашли, выдайте разовую карточку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私密账户没有链接也没有二维码——它根本没有标识符。若要让人找到您，请发放一次性名片。"
          }
        }
      }
    },
    "A private account has no name to be found by. What it hands over is a one-time card: it opens one correspondence with you and nothing else.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватный аккаунт не имеет имени, по которому его находят. То, что он передаёт, — разовая карточка: она открывает одну переписку с вами и ничего больше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私密账户没有可供查找的名称。它交出的是一次性名片：只开启与您的一段通信，别无其他。"
          }
        }
      }
    },
    "A private messenger. Your identity comes from your secret phrase, and your chats are encrypted on your device.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватный мессенджер. Личность — из вашей секретной фразы, переписка зашифрована на вашем устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私密通讯工具。您的身份源自您的助记词，聊天内容在您的设备上加密。"
          }
        }
      }
    },
    "A public account needs a username — people find you by it. For a private account skip this page: then you have no identifier at all.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для публичного аккаунта имя пользователя обязательно — по нему вас и находят. Для приватного аккаунта пропустите эту страницу: тогда у вас нет никакого идентификатора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开账户必须设置用户名——别人正是通过它找到您。若要私密账户，请跳过此页：那样您将不带任何标识符。"
          }
        }
      }
    },
    "A right becomes a wallet note only after the core confirms its redemption.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Право становится заметкой кошелька только после подтверждения погашения ядром."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权益仅在核心确认兑付后才成为钱包票据。"
          }
        }
      }
    },
    "A screenshot was taken, and it now holds your identity. Delete it, and keep the words on paper or in a password manager.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделан снимок экрана — теперь он хранит ваш личность. Удалите его, а слова держите на бумаге или в менеджере паролей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已截屏，这张截图现在持有您的账户。请删除它，并把助记词记在纸上或存入密码管理器。"
          }
        }
      }
    },
    "A swipe from the left leaves a file out of the copy; a swipe from the right deletes it from the chat.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните вправо, чтобы убрать файл из копии; влево — чтобы удалить его из чата."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向右轻扫可将文件移出副本；向左轻扫可将其从聊天中删除。"
          }
        }
      }
    },
    "A username cannot be removed: a public account always has one. Enter another free name — becoming private is possible only at registration, by skipping this step.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя пользователя нельзя убрать: у публичного аккаунта оно есть всегда. Введите другое свободное имя — приватным можно стать только при регистрации, пропустив этот шаг."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户名无法移除：公开账户始终拥有用户名。请输入另一个可用名称——只有在注册时跳过该步骤才能转为私密。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О себе"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于我"
          }
        }
      }
    },
    "Accept": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принять"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接听"
          }
        }
      }
    },
    "Accept draw": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Согласиться на ничью"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意和棋"
          }
        }
      }
    },
    "Accept invitation": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принять приглашение"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受邀请"
          }
        }
      }
    },
    "Accepting opens a direct link: they will see your network address, as you see theirs. That is the price of having no one in the middle.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принятие открывает прямую связь: собеседник увидит ваш сетевой адрес, как и вы — его. Это цена того, что между вами никого нет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受即建立直连：对方会看到你的网络地址，你也会看到对方的。这就是中间没有任何人的代价。"
          }
        }
      }
    },
    "Accurate to %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С точностью до %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精确到 %@"
          }
        }
      }
    },
    "Active": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активно"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在参与"
          }
        }
      }
    },
    "Add %lld photos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Add %lld photo"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Add %lld photos"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Добавить %lld фото"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Добавить %lld фото"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "添加 %lld 张照片"
                }
              }
            }
          }
        }
      }
    },
    "Add Photos Only": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только добавлять фото"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅添加照片"
          }
        }
      }
    },
    "Add a caption…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте подпись…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加说明…"
          }
        }
      }
    },
    "Add a server": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить сервер"
          }
        },
